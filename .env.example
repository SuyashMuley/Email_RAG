DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
POSTGRES_PORT=5432

OLLAMA_HOST=http://localhost:11434
LLM_MODEL=llama3.1:8b

EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384

GMAIL_CREDENTIALS_PATH=secrets/credentials.json
TOKEN_DIR=secrets

# Restricted role used by the API and ingestion (row-level security enforced)
APP_DATABASE_URL=postgresql://rag_app:rag_app@localhost:5432/rag

# local = tokens from `rag token` (dev/demo); google = Google ID tokens
AUTH_MODE=local
LOCAL_JWT_SECRET=
# GOOGLE_CLIENT_ID=   (google mode; defaults to the id in credentials.json)
